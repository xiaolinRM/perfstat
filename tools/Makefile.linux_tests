#========================================================================================
# perfstat - Linux 自检工具构建
#
#   make -f tools/Makefile.linux_tests                  # 两个都编
#   make -f tools/Makefile.linux_tests smoke            # 只编冒烟测试
#   ./build/perfstat_loader_test_linux Release/perfstat_srv.so
#   ./build/perfstat_smoke_linux 60
#
# 自检程序需要用到平台层（模块枚举 / 采样）来交叉验证，所以直接编译
# src/perf_platform_linux.cpp 进测试程序里（不是链接进 .so）。
#
# ⚠️ 注意：这里【只编平台层，不编 core.cpp】。所以 src/perf_platform_linux.cpp
#    绝对不能引用 core.cpp 或插件入口里的全局变量/函数，否则会 undefined reference
#    （踩过一次：平台层引用了 core.cpp 里的 g_perfstat_verbose_flag）。
#    平台层自己的诊断开关是 ps_set_debug()，自持标志。
#    如果你改了平台层，本地跑一下这个 Makefile 就能提前发现这类耦合问题。
#
# ⚠️ 另一个约束：perfstat_loader_test_linux 会 dlopen 插件，于是进程里会有
#    【两份平台层副本】（自检一份、插件一份），信号处理器是进程级、后装覆盖先装的。
#    所以这个程序【不要自己发起采样】—— 那会和插件的处理器抢槽位表。
#    平台层的采样验证放在 perfstat_smoke_linux 里做（那里只有一份副本）。
#
# ⚠️ 第三个约束：因为不编 core.cpp，从插件里取到 Profiler* 之后，
#    【只能调用 core.h 里的 inline 成员】（running / auto_stop_sec / total_samples /
#    module_count / thread_count / sample_interval_ms / sample_errors），
#    不能调用定义在 core.cpp 里的 elapsed_seconds()，否则链接期就报 undefined reference
#    （两个坑都踩过）。
#========================================================================================

CXX      = g++
CXXFLAGS = -m32 -std=c++11 -O2 -Wall -Wno-unused-parameter -Wno-write-strings \
           -DNDEBUG -DLINUX -D_stricmp=strcasecmp -D_strnicmp=strncasecmp
LDFLAGS  = -m32
LIBS     = -lpthread -ldl

SRCDIR    = src
BINDIR    = build
PLAT      = $(SRCDIR)/perf_platform_linux.cpp
TARGET    = $(BINDIR)/perfstat_loader_test_linux
SMOKE     = $(BINDIR)/perfstat_smoke_linux

#----------------------------------------------------------------------------------------
# 防护网：平台层不能引用 core.cpp / 插件入口的符号
#
# 原因：本 Makefile 只编 src/perf_platform_linux.cpp，不编 core.cpp。
# 一旦平台层引用了 core.cpp 或 perfstat.cpp 里的东西，链接期才会报 undefined reference，
# 而这个错误在 Windows 侧永远测不出来（那边编了 core.cpp）。
# 这条约束已经踩过三次：g_perfstat_verbose_flag / elapsed_seconds / ps_dbg_now_ms。
#
# 所以这里在构建前直接扫一遍源码，命中就立刻失败并给出清晰提示。
#----------------------------------------------------------------------------------------
PLAT_FORBIDDEN := ps_dbg_now_ms|g_perfstat_verbose_flag|elapsed_seconds|g_profiler|ps_dbg_lock

.PHONY: check-platform-layering
check-platform-layering:
	@if grep -nE '$(PLAT_FORBIDDEN)' $(PLAT) | grep -v '^\s*//' | grep -vE '踩过|为什么不用|这条约束'; then \
		echo ""; \
		echo "!! 平台层引用了 core.cpp / 插件入口的符号（见上面几行）"; \
		echo "!! 本 Makefile 只编平台层，不编 core.cpp —— 这会导致 undefined reference。"; \
		echo "!! 平台层只能依赖 platform.h 和 C 运行库；诊断开关用 ps_set_debug()，"; \
		echo "!! 时间戳之类的工具请在平台层内部自带一份 static 实现。"; \
		exit 1; \
	fi
	@echo "OK: 平台层分层检查通过（没有引用 core.cpp / 插件入口的符号）"

all: check-platform-layering $(TARGET) $(SMOKE)

$(BINDIR):
	mkdir -p $(BINDIR)

$(TARGET): tools/perfstat_loader_test_linux.cpp $(SRCDIR)/perf_platform_linux.cpp | $(BINDIR)
	$(CXX) $(CXXFLAGS) -I$(SRCDIR) -o $@ $^ $(LDFLAGS) $(LIBS)
	@echo "构建完成: $(TARGET)"

$(SMOKE): tools/perfstat_smoke_linux.cpp $(SRCDIR)/perf_platform_linux.cpp | $(BINDIR)
	$(CXX) $(CXXFLAGS) -I$(SRCDIR) -o $@ $^ $(LDFLAGS) $(LIBS)
	@echo "构建完成: $(SMOKE)"

smoke: check-platform-layering $(SMOKE)

clean:
	rm -f $(TARGET) $(SMOKE)

.PHONY: all smoke clean
